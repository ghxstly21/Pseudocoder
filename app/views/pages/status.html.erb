<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
        background: #f9f9f9;
    }

    .status-wrap {
        max-width: 860px;
        margin: 2rem auto 4rem;
        padding: 0 1.5rem;
        text-align: center;
    }

    .status-title {
        font-family: 'Oswald', sans-serif;
        color: #044caa;
        font-size: 2.4rem;
        margin: 2rem 0 0.75rem;
    }

    .status-card {
        background: #ffffff;
        border-radius: 10px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);

        padding: 1.5rem;
        margin-top: 1.5rem;
        margin-bottom: 300px;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.9rem;
        border-radius: 999px;
        background: #e8fff1;
        color: #044caa;
        font-weight: 700;
        font-size: 0.9rem;
    }

    .status-pill::before {
        content: "";
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: #22c55e;
    }

    .status-text {
        color: #555;
        margin: 0.75rem 0 0;
        line-height: 1.6;
    }
</style>

<section class="status-wrap">
    <h1 class="status-title">System Status</h1>
    <div class="status-card">
        <span class="status-pill">All Systems Operational</span>
        <p class="status-text">If you can load this site, Pseudocoder is running. That is the status.</p>
    </div>
</section>