<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
        background: #f5f5f5;
        margin: 0;
    }

    .services-header {
        font-family: 'Oswald', sans-serif;
        color: #044caa;
        text-align: center;
        margin: 3rem 0 1rem;
        font-size: 2.5rem;
        text-transform: uppercase;
    }

    .services-subtitle {
        text-align: center;
        color: #666;
        margin-bottom: 3rem;
        font-size: 1.1rem;
    }

    .services-container {
        max-width: 1200px;
        margin: 0 auto 4rem;
        padding: 0 2rem;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
        margin-top: 2rem;
    }

    .service-card {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border-top: 4px solid #044caa;
    }

    .service-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 8px 16px rgba(4, 76, 170, 0.2);
    }

    .service-icon {
        font-size: 3rem;
        color: #044caa;
        margin-bottom: 1.5rem;
    }

    .service-title {
        font-size: 1.5rem;
        font-weight: 600;
        color: #333;
        margin-bottom: 1rem;
    }

    .service-description {
        color: #666;
        line-height: 1.6;
        font-size: 0.95rem;
    }

    .service-card-python {
        background: white;
        border-radius: 12px;
        padding: 2rem;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        transition: all 0.3s ease;
        border-top: 4px solid #044caa;
    }

    .service-card-python:hover {
        transform: translateY(20px);

        background-image: url(<%= image_path('miguelfaceicon.png') %>);

    }

    @media screen and (max-width: 768px) {
        .services-grid {
            grid-template-columns: 1fr;
        }

        .services-header {
            font-size: 2rem;
        }
    }
</style>

<div class="services-container">
    <h1 class="services-header">Our Services</h1>
    <p class="services-subtitle">We support multiple programming languages to help you convert pseudocode to real code</p>

    <div class="services-grid">
        <div class="service-card">
            <div class="service-icon">
                <i class="fa-brands fa-java"></i>
            </div>
            <h2 class="service-title">Java</h2>
            <p class="service-description">Java is a widely used, high-level, object-oriented programming language designed for maximum portability with the "Write Once, Run Anywhere" (WORA) principle.</p>
        </div>

        <div class="service-card">
            <div class="service-icon">
                <i class="fa-brands fa-js"></i>
            </div>
            <h2 class="service-title">JavaScript</h2>
            <p class="service-description">JavaScript is a versatile, high-level programming language that is one of the core technologies of the World Wide Web, alongside HTML and CSS.</p>
        </div>

        <div class="service-card-python">
            <div class="service-icon">
                <i class="fa-brands fa-python"></i>
            </div>
            <h2 class="service-title">Python</h2>
            <p class="service-description">Python is a high-level, general-purpose programming language known for its simplicity, readability, and versatility.</p>
        </div>
    </div>
</div>