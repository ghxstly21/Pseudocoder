<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css">

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
        background-image: url(<%= image_path('backgroundhome.jpg') %>);
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }



    .top-bar {
        margin-top: 1rem;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 1rem;
        background: #ffffff;
        width: fit-content;
        border-radius: 999px;
        margin-left: 2rem;
    }

    .top-bar-right {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .top-bar-user {
        font-family: 'Oswald', sans-serif;
        color: #044caa;
        font-weight: 700;
        font-size: 1.2rem;
    }



    .auth-options {
        text-align: center;
        margin: 3rem 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .auth-lead {
        font-size: 1.1rem;
        color: #ffffff;
        margin-bottom: 0.5rem;
    }

    .auth-footnote {
        color: #ffffff;
        font-size: 0.9rem;
    }

    .auth-signup-link {
        color: #78b2ff;
        font-weight: 600;
    }

    .auth-button {
        padding: 12px 24px;
        font-size: 1rem;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
        text-decoration: none;
    }

    .auth-button-primary {
        background: #044caa;
        color: white;
    }

    .auth-button-primary:hover {
        background: #065ac7;
    }

    .auth-button-secondary {
        background: #ffffff;
        color: #333;
        border: 2px solid #066ef6;
    }

    .auth-button-secondary:hover {
        background: #b1d0f8;
    }

    .header {
        font-family: 'Oswald', sans-serif;
        color: #a0c9ff;
        margin: 80px auto 40px auto;
        text-align: center;
        font-size: 2.5rem;
        padding: 0.75rem 2rem;
        border-radius: 999px;

    }

    .flash-notice {
        background: #d1fae5;
        width: fit-content;
        padding: 0.75rem 5rem;
        border-radius: 6px;
        margin: auto;
        margin-bottom: 1rem;
        color: #013476;
        text-align: center;
        font-weight: 600;
    }

    .pseudocode-panel {
        max-width: 800px;
        margin: 2rem auto;
        background: #e8fff1;
        padding: 1.5rem;
        border-radius: 10px;
        border-left: 4px solid #044caa;
    }

    .pseudocode-heading {
        color: #044caa;
        margin-top: 0;
    }

    .pseudocode-pre {
        background: white;
        padding: 1rem;
        border-radius: 6px;
        overflow-x: auto;
        font-family: monospace;
    }

    .compile-form {
        background: #fafafa;
        padding: 1rem;
        border-radius: 10px;
        margin: 0 auto 2rem;
        box-shadow: 0 1px 6px rgba(0, 0, 0, 0.08);
        max-width: 800px;
    }

    .code-input {
        width: 100%;
        font-family: monospace;
        padding-bottom: 0.75rem;
        padding-left: 0.75rem;
        padding-right: 0.75rem;
        border: 1px solid #ccc;
        border-radius: 6px;
    }

    .file-input {
        margin-top: 0.75rem;
        padding: 0.75rem 1rem;
        background: white;
        border-radius: 6px;
        cursor: pointer;
        width: 100%;
        font-size: 14px;
    }

    .file-input::file-selector-button {
        padding: 0.5rem 1rem;
        background: #044caa;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        margin-right: 1rem;
    }

    .file-input::file-selector-button:hover {
        background: #033580;
    }

    .file-input-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .clear-file-button {
        display: none;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border: 1px solid #ccc;
        border-radius: 6px;
        background: #ffffff;
        cursor: pointer;
        font-weight: 700;
    }

    .save-compilation-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.75rem;
        color: #333;
        cursor: pointer;
    }

    .save-compilation-check {
        cursor: pointer;
    }

    .or-divider {
        text-align: center;
        margin: 0.75rem 0;
        color: #888;
    }

    .submit-btn {
        margin-top: 0.75rem;
        width: 100%;
        padding: 0.75rem 1.5rem;
        background: #044caa;
        color: white;
        border: none;
        border-radius: 6px;
        cursor: pointer;
        font-size: 1rem;
        font-weight: 600;
        transition: background 0.3s;
    }

    .submit-btn:hover {
        background: #0557c2;
    }

    .submit-btn:active {
        transform: scale(0.98);
    }

    .page-title {
        font-family: 'Oswald', sans-serif;
        color: #a0c9ff;
        text-align: center;
        margin: 3rem 0 1.5rem;
        font-size: 2rem;

    }

    .history-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        max-width: 1200px;
        margin: 0 auto 4rem;
    }

    .history-card {
        background: #ffffff;
        border-radius: 10px;
        padding: 1.5rem;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
        border-left: 4px solid #044caa;
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .history-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    }

    .history-meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.85rem;
        color: #666;
        margin-bottom: 0.75rem;
    }

    .history-age {
        margin-left: 1rem;
        color: #999;
    }

    .history-language {
        display: inline-block;
        background: #e8fff1;
        color: #044caa;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.8rem;
    }

    .history-delete-btn {
        background: #ef4444;
        color: white;
        border: none;
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8rem;
        transition: background 0.2s;
    }

    .history-more-btn {
        background: #044caa;
        color: white;
        border: none;
        padding: 0.35rem 0.75rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8rem;
        text-decoration: none;
        transition: background 0.2s;
        display: inline-block;
    }

    .history-more-btn:hover {
        background: #033580;
    }

    .history-actions {
        display: flex;
        gap: 0.5rem;
        align-items: center;
    }

    .history-delete-btn:hover {
        background: #dc2626;
    }

    .history-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-top: 0.75rem;
    }

    .history-section {
        display: flex;
        flex-direction: column;
    }

    .history-section strong {
        color: #666;
        font-size: 0.85rem;
        margin-bottom: 0.5rem;
        display: block;
    }

    .history-input {
        background: #f4f4f4;
        padding: 0.75rem;
        border-radius: 6px;
        overflow-x: auto;
        margin: 0;
        flex: 1;
    }

    .history-output {
        background: #e8fff1;
        padding: 0.75rem;
        border-radius: 6px;
        margin: 0;
        flex: 1;
        overflow-x: auto;
    }

    @media screen and (max-width: 768px) {
        .history-content {
            grid-template-columns: 1fr;
        }
    }

    .empty-state {
        text-align: center;
        color: #888;
        font-style: italic;
    }

    .empty-state-on-dark {
        color: #ffffff;
    }

    .contact-header {
        font-family: 'Oswald', sans-serif;
        color: #044caa;
        text-align: center;
        margin: 3rem 0 1rem;
        font-size: 2.5rem;
    }

    .contact-subtitle {
        text-align: center;
        color: #666;
        margin-bottom: 3rem;
        font-size: 1.1rem;
    }

    .contact-wrapper {
        display: flex;
        gap: 3rem;
        max-width: 1200px;
        margin: 0 auto 4rem;
        padding: 0 2rem;
    }

    .contact-form-section {
        flex: 1;
        min-width: 300px;
    }

    .contact-info-section {
        flex: 0 0 300px;
    }

    .contact-info-card {
        background: white;
        padding: 1.5rem;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 1.5rem;
        border-left: 4px solid #044caa;
    }

    .contact-info-card h3 {
        color: #044caa;
        margin: 0 0 0.5rem;
        font-size: 1.1rem;
    }

    .contact-info-card p {
        margin: 0;
        color: #666;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .form-container {
        background: #fafafa;
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: #333;
        font-weight: 600;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 1rem;
        font-family: inherit;
        box-sizing: border-box;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #044caa;
        box-shadow: 0 0 0 3px rgba(4, 76, 170, 0.1);
    }

    .form-group textarea {
        resize: vertical;
        min-height: 150px;
    }

    .notice {
        padding: 0.75rem 1.5rem;
        color: #04387d;
        text-align: center;
        font-weight: 600;
        background: #ffff;
        width: fit-content;
        margin: 0 auto;
    }

    .flash-alert {
        background: #fee2e2;
        padding: 1rem;
        border-radius: 6px;
        color: #991b1b;
        text-align: center;
        font-weight: 600;
        width: fit-content;
        margin: auto;
        margin-bottom: 1.5rem;

    }

    @media (max-width: 768px) {
        .contact-wrapper {
            flex-direction: column;
            gap: 2rem;
        }

        .contact-info-section {
            flex: 1;
        }

        .contact-header {
            font-size: 2rem;
            margin: 2rem 0 1rem;
        }
    }
</style>

<% if current_user.present? %>
<div class="top-bar">
    <div class="top-bar-user">
        <% if session[:guest_session] %>
        Guest Session
        <% else %>
        <%= current_user.name %>
        <% end %>
    </div>
</div>
<h1 class="header">Understand all your code with ease using Pseudocoder</h1>
<% else %>
<h1 class="header">Understand all your code with ease using Pseudocoder</h1>
<div class="auth-options">
    <p class="auth-lead">Sign in to save your compilation history</p>
    <a href="/login" class="auth-button auth-button-primary">Sign in as User</a>
    <a href="/guest_login" class="auth-button auth-button-secondary">Continue as Guest</a>
    <p class="auth-footnote">Don't have an account? <a href="/signup" class="auth-signup-link">Create one</a></p>
</div>
<% end %>

<% if flash[:notice] %>
<p class="flash-notice"><%= flash[:notice] %></p>
<% end %>

<% if flash[:alert] %>
<p class="flash-alert"><%= flash[:alert] %></p>
<% end %>

<% if @pseudocode_output.present? %>
<div class="pseudocode-panel">
    <h3 class="pseudocode-heading">Generated Pseudocode:</h3>
    <pre class="pseudocode-pre"><%= @pseudocode_output %></pre>
</div>
<% else %>
<p class="notice">Please avoid submitting gibberish code, since the compiler may return complex errors.</p>

<% end %>
<%= form_with url: compilations_path, multipart: true, local: true do |f| %>
<div class="compile-form">
    <%= f.text_area :code, placeholder: "Paste code here...", rows: 8, class: "code-input", id: "code-input" %>

    <div class="or-divider">OR</div>

    <div class="file-input-row">
        <%= f.file_field :file, class: "file-input", id: "file-input" %>
        <button type="button" id="clear-file" class="clear-file-button">x</button>
    </div>

    <% if current_user.present? && !session[:guest_session] %>
    <label class="save-compilation-label">
        <%= f.check_box :save_compilation, class: "save-compilation-check" %>
        <span>Save compilation</span>
    </label>
    <% end %>

    <%= f.submit "Generate Pseudocode", class: "submit-btn" %>
</div>
<% end %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        var codeInput = document.getElementById("code-input");
        var fileInput = document.getElementById("file-input");
        var clearFileButton = document.getElementById("clear-file");
        var editor = null;

        if (codeInput && window.CodeMirror) {
            editor = CodeMirror.fromTextArea(codeInput, {
                lineNumbers: true,
                indentUnit: 4,
                indentWithTabs: false,
                tabSize: 4
            });

            var form = codeInput.closest("form");
            if (form) {
                form.addEventListener("submit", function() {
                    editor.save();
                });
            }
        }

        function getCodeValue() {
            if (editor) {
                return editor.getValue();
            }
            return codeInput ? codeInput.value : "";
        }

        function setCodeDisabled(disabled) {
            if (editor) {
                editor.setOption("readOnly", disabled ? "nocursor" : "");
                editor.getWrapperElement().style.opacity = disabled ? "0.6" : "1";
            }
            if (codeInput) {
                codeInput.disabled = disabled;
            }
        }

        function setFileDisabled(disabled) {
            if (fileInput) {
                fileInput.disabled = disabled;
            }
            if (clearFileButton) {
                clearFileButton.disabled = disabled;
                clearFileButton.style.opacity = disabled ? "0.4" : "1";
            }
        }

        function updateState() {
            var hasFile = fileInput && fileInput.files && fileInput.files.length > 0;
            var hasCode = getCodeValue().trim().length > 0;

            if (hasFile) {
                setCodeDisabled(true);
                setFileDisabled(false);
            } else if (hasCode) {
                setFileDisabled(true);
                setCodeDisabled(false);
            } else {
                setFileDisabled(false);
                setCodeDisabled(false);
            }

            if (clearFileButton) {
                clearFileButton.style.display = hasFile ? "inline-flex" : "none";
            }
        }

        if (fileInput) {
            fileInput.addEventListener("change", updateState);
        }

        if (clearFileButton) {
            clearFileButton.addEventListener("click", function() {
                if (fileInput) {
                    fileInput.value = "";
                }
                updateState();
            });
        }

        if (editor) {
            editor.on("change", updateState);
        }

        if (codeInput) {
            codeInput.addEventListener("input", updateState);
        }

        updateState();
    });
</script>


<h1 class="page-title">Compilation History</h1>

<div class="history-container">
    <% if current_user && @compilations.present? %>
    <% @compilations.each do |c| %>
    <div class="history-card">
        <div class="history-meta">
            <div>
                <span class="history-language"><%= c.language %></span>
                <span class="history-age">
                    <%= time_ago_in_words(c.created_at) %> ago
                </span>
            </div>
            <div class="history-actions">
                <%= link_to "More info", compilation_path(c), class: "history-more-btn" %>
                <%= button_to "Delete", compilation_path(c), method: :delete, class: "history-delete-btn" %>
            </div>
        </div>

        <div class="history-content">
            <div class="history-section">
                <strong>Input:</strong>
                <pre class="history-input"><%= truncate(c.input_text, length: 4000) %></pre>
            </div>

            <div class="history-section">
                <strong>Pseudocode Output:</strong>
                <pre class="history-output"><%= truncate(c.output_text, length: 4000) %></pre>
            </div>
        </div>
    </div>
    <% end %>
    <% else %>
    <p class="empty-state empty-state-on-dark">No history yet. <% if current_user %>Run some code!<% else %>Sign in to save your compilations.<% end %></p>
    <% end %>
</div>