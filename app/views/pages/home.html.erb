<link rel="stylesheet" href="/tailwind.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Oswald:wght@200..700&display=swap" rel="stylesheet">


<style>
    .header {
        font-family: Oswald;
        font-color: 04AA6D;
        margin: 200px;
        text-align: center;

    }

    .auth-links {
        text-align: center;
        font-family: 'Oswald', sans-serif;
        font-size: 1.2rem;
        color: #444;
    }

    .auth-links a {
        color: #04AA6D;
        text-decoration: none;
        font-weight: 500;
    }

    .auth-links a:hover {
        text-decoration: underline;
    }

    .user-name {
        color: #04AA6D;
        font-weight: bold;
    }

    .button {
        border: none;
        outline: 0;
        display: inline-block;
        padding: 8px;
        color: white;
        background-color: #000;
        text-align: center;
        cursor: pointer;
        width: 100%;
    }

    .button:hover {
        background-color: #555;
    }
</style>
<h1 class="header">Understand all your code with ease using Psuedocoder</h1>
<div class="auth-links">

    <p> Hello </p>

    <% if current_user.present? %>
    <p>
        <%= current_user.name%>
    </p>
    <% else%>
    <p> guest </p>

    <% end %>


    <p><a href="/login"><button class="button">Log in as user</button></a></p>
    <p><a href="/login_guest"><button class="button">Log in as guests</button></a></p>


</div>