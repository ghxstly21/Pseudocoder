<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
        background-image: url(<%= image_path('background2.png') %>);
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
    }

    .form-container {
        max-width: 400px;
        margin: 4rem auto;
        padding: 2rem;
        border: 1px solid #ddd;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        background: #ffffffdb;
    }

    h1 {
        text-align: center;
        color: #000000;
        margin-bottom: 1.5rem;
        style: bold;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    label {
        display: block;
        margin-bottom: 0.5rem;
        color: #333;
        font-weight: 500;
    }

    input {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 4px;
        font-size: 1rem;
        box-sizing: border-box;
    }

    input:focus {
        outline: none;
        border-color: #044caa;
        box-shadow: 0 0 0 3px rgba(4, 170, 109, 0.1);
    }

    button {
        width: 100%;
        padding: 0.75rem;
        background: #044caa;
        color: white;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.3s;
    }

    button:hover {
        background: #0557c2;
    }

    .error-message {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .success-message {
        color: #044caa;
        background: #f0fdf4;
        padding: 1rem;
        border-radius: 4px;
        margin-bottom: 1.5rem;
        border-left: 4px solid #044caa;
    }

    .login-link {
        text-align: center;
        margin-top: 1rem;
    }

    .login-link a {
        color: #044caa;
        text-decoration: none;
    }

    .login-link a:hover {
        text-decoration: underline;
    }
</style>

<div class="form-container">
    <h1>Forgot Password</h1>

    <% if alert %>
    <div class="error-message"><%= alert %></div>
    <% end %>

    <form action="<%= forgot_password_path %>" method="POST">
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

        <div class="form-group">
            <label for="email">Email Address *</label>
            <input type="email" id="email" name="email" required>
        </div>

        <button type="submit">Send Reset Link</button>
    </form>

    <div class="login-link">
        <%= link_to "Back to Login", login_path %>
    </div>
</div>