<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
    }

    .settings-header {
        font-family: 'Oswald', sans-serif;
        color: #04AA6D;
        text-align: center;
        margin: 3rem 0 1rem;
        font-size: 2.5rem;
    }

    .settings-subtitle {
        text-align: center;
        color: #666;
        margin-bottom: 3rem;
        font-size: 1.1rem;
    }

    .settings-wrapper {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin: 0 auto 4rem;
    }

    .settings-form-section {
        flex: 1;
        min-width: 300px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        width: 100%;
        box-sizing: border-box;
    }

    .settings-sidebar {
        flex: 1;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        width: 100%;
        background: #f9f9f9;
        padding: 3rem 2rem;
        margin-top: 3rem;
    }

    .settings-card {
        background: white;
        padding: 1.5rem;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 1.5rem;
        border-left: 4px solid #04AA6D;
    }

    .settings-card h3 {
        margin-top: 0;
        color: #333;
    }

    .settings-card p {
        color: #666;
        margin-bottom: 0;
    }

    .form-container {
        background: white;
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 2rem;
    }

    .form-container h2 {
        margin-top: 0;
        color: #333;
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 1rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        font-weight: 600;
        color: #333;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 1rem;
        font-family: inherit;
        box-sizing: border-box;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #04AA6D;
        box-shadow: 0 0 0 3px rgba(4, 170, 109, 0.1);
    }

    .submit-btn {
        width: 100%;
        padding: 0.75rem;
        background: #04AA6D;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s;
    }

    .submit-btn:hover {
        background: #038a57;
    }

    .error-message {
        color: #dc2626;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .flash-notice {
        background: #d1fae5;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
        color: #065f46;
        border-left: 4px solid #04AA6D;
    }

    .flash-alert {
        background: #fee2e2;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
        color: #991b1b;
        border-left: 4px solid #dc2626;
    }

    @media (max-width: 768px) {
        .settings-wrapper {
            flex-direction: column;
        }

        .settings-sidebar {
            flex: 1;
        }
    }
</style>

<h1 class="settings-header">Account Settings</h1>
<p class="settings-subtitle">Manage your account information and security</p>

<div class="settings-wrapper">
    <div class="settings-form-section">
        <% if notice %>
        <div class="flash-notice"><%= notice %></div>
        <% end %>
        <% if alert %>
        <div class="flash-alert"><%= alert %></div>
        <% end %>

        <div class="form-container">
            <h2>Profile Information</h2>
            <%= form_with url: user_path(@user), method: :patch, local: true do |f| %>
            <div class="form-group">
                <label for="name">Full Name</label>
                <%= f.text_field :name, placeholder: "Enter your full name", value: @user.name %>
                <% if @user.errors[:name].any? %>
                <div class="error-message"><%= @user.errors[:name].join(", ") %></div>
                <% end %>
            </div>

            <%= f.submit "Update Profile", class: "submit-btn" %>
            <% end %>
        </div>

        <div class="form-container">
            <h2>Change Email</h2>
            <p style="color: #666; margin-bottom: 1.5rem;">Current Email: <strong><%= @user.email %></strong></p>

            <% if @user.pending_email.present? %>
            <div class="flash-notice">
                Confirmation email sent to <strong><%= @user.pending_email %></strong>. Please check your inbox.
            </div>
            <% end %>

            <%= form_with url: change_email_path, method: :post, local: true do |f| %>
            <div class="form-group">
                <label for="new_email">New Email Address</label>
                <input type="email" id="new_email" name="new_email" placeholder="Enter your new email address" required>
            </div>

            <%= f.submit "Change Email", class: "submit-btn" %>
            <% end %>
        </div>

        <div class="form-container">
            <h2>Change Password</h2>
            <%= form_with url: user_path(@user), method: :patch, local: true do |f| %>
            <div class="form-group">
                <label for="current_password">Current Password</label>
                <input type="password" id="current_password" name="user[current_password]" placeholder="Enter your current password" required>
                <% if @user.errors[:current_password].any? %>
                <div class="error-message"><%= @user.errors[:current_password].join(", ") %></div>
                <% end %>
            </div>

            <div class="form-group">
                <label for="password">New Password</label>
                <input type="password" id="password" name="user[password]" placeholder="Enter a new password (minimum 6 characters)" required>
                <% if @user.errors[:password].any? %>
                <div class="error-message"><%= @user.errors[:password].join(", ") %></div>
                <% end %>
            </div>

            <div class="form-group">
                <label for="password_confirmation">Confirm New Password</label>
                <input type="password" id="password_confirmation" name="user[password_confirmation]" placeholder="Confirm your new password" required>
                <% if @user.errors[:password_confirmation].any? %>
                <div class="error-message"><%= @user.errors[:password_confirmation].join(", ") %></div>
                <% end %>
            </div>

            <%= f.submit "Update Password", class: "submit-btn" %>
            <% end %>
        </div>
    </div>
    <div class="buff">
    </div>