<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@200..700&display=swap" rel="stylesheet">

<style>
    body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', sans-serif;
    }

    .contact-header {
        font-family: 'Oswald', sans-serif;
        color: #04AA6D;
        text-align: center;
        margin: 3rem 0 1rem;
        font-size: 2.5rem;
    }

    .contact-subtitle {
        text-align: center;
        color: #666;
        margin-bottom: 3rem;
        font-size: 1.1rem;
    }

    .contact-wrapper {
        display: flex;
        gap: 3rem;
        max-width: 1200px;
        margin: 0 auto 4rem;
        padding: 0 2rem;
    }

    .contact-form-section {
        flex: 1;
        min-width: 300px;
    }

    .contact-info-section {
        flex: 0 0 300px;
    }

    .contact-info-card {
        background: white;
        padding: 1.5rem;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        margin-bottom: 1.5rem;
        border-left: 4px solid #04AA6D;
    }

    .contact-info-card h3 {
        color: #04AA6D;
        margin: 0 0 0.5rem;
        font-size: 1.1rem;
    }

    .contact-info-card p {
        margin: 0;
        color: #666;
        font-size: 0.95rem;
        line-height: 1.5;
    }

    .form-container {
        background: #fafafa;
        padding: 2rem;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: #333;
        font-weight: 600;
    }

    .form-group input,
    .form-group select,
    .form-group textarea {
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ccc;
        border-radius: 6px;
        font-size: 1rem;
        font-family: inherit;
        box-sizing: border-box;
    }

    .form-group input:focus,
    .form-group select:focus,
    .form-group textarea:focus {
        outline: none;
        border-color: #04AA6D;
        box-shadow: 0 0 0 3px rgba(4, 170, 109, 0.1);
    }

    .form-group textarea {
        resize: vertical;
        min-height: 150px;
    }

    .submit-btn {
        width: 100%;
        padding: 0.75rem;
        background: #04AA6D;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s;
    }

    .submit-btn:hover {
        background: #038a57;
    }

    .submit-btn:active {
        transform: scale(0.98);
    }

    .flash-notice {
        background: #d1fae5;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
        color: #065f46;
        text-align: center;
        font-weight: 600;
    }

    .flash-alert {
        background: #fee2e2;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
        color: #991b1b;
        text-align: center;
        font-weight: 600;
    }

    @media (max-width: 768px) {
        .contact-wrapper {
            flex-direction: column;
            gap: 2rem;
        }

        .contact-info-section {
            flex: 1;
        }

        .contact-header {
            font-size: 2rem;
            margin: 2rem 0 1rem;
        }
    }
</style>

<h1 class="contact-header">Get in Touch</h1>
<p class="contact-subtitle">Have questions? We'd love to hear from you!</p>

<% if notice %>
<div style="max-width: 1200px; margin: 0 auto; padding: 0 2rem;">
    <p class="flash-notice"><%= notice %></p>
</div>
<% end %>

<% if alert %>
<div style="max-width: 1200px; margin: 0 auto; padding: 0 2rem;">
    <p class="flash-alert"><%= alert %></p>
</div>
<% end %>

<div class="contact-wrapper">
    <div class="contact-form-section">
        <div class="form-container">
            <form action="/contact_submit" method="POST">
                <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

                <div class="form-group">
                    <label for="firstname">First Name *</label>
                    <input type="text" id="firstname" name="firstname" required>
                </div>

                <div class="form-group">
                    <label for="lastname">Last Name *</label>
                    <input type="text" id="lastname" name="lastname" required>
                </div>

                <div class="form-group">
                    <label for="country">Country *</label>
                    <select id="country" name="country" required>
                        <option value="">-- Select a country --</option>
                        <option value="australia">Australia</option>
                        <option value="canada">Canada</option>
                        <option value="usa">USA</option>
                        <option value="uk">United Kingdom</option>
                        <option value="india">India</option>
                        <option value="other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="subject">Message *</label>
                    <textarea id="subject" name="subject" required></textarea>
                </div>

                <button type="submit" class="submit-btn">Send Message</button>
            </form>
        </div>
    </div>

    <div class="contact-info-section">
        <div class="contact-info-card">
            <h3>📧 Email</h3>
            <p><a href="mailto:support@pseudocoder.com" style="color: #04AA6D; text-decoration: none;">support@pseudocoder.com</a></p>
        </div>

        <div class="contact-info-card">
            <h3>🌐 Social</h3>
            <p>Follow us on social media for updates and tips</p>
        </div>

        <div class="contact-info-card">
            <h3>⏱️ Response Time</h3>
            <p>We typically respond within 24-48 hours during business days</p>
        </div>

        <div class="contact-info-card">
            <h3>🚀 Quick Links</h3>
            <p><a href="<%= home_path %>" style="color: #04AA6D; text-decoration: none; font-weight: 600;">Back to Compiler</a></p>
        </div>
    </div>
</div>