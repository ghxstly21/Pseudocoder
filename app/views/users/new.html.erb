<style>
    .signup-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 80vh;
        padding: 2rem;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    }

    .signup-container {
        background: white;
        padding: 3rem;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.15);
        width: 100%;
        max-width: 500px;
    }

    .signup-header {
        font-family: 'Oswald', sans-serif;
        color: #044caa;
        font-size: 2rem;
        text-align: center;
        margin-bottom: 0.5rem;
    }

    .signup-subtitle {
        text-align: center;
        color: #666;
        margin-bottom: 2rem;
        font-size: 0.95rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-group label {
        display: block;
        margin-bottom: 0.5rem;
        color: #333;
        font-weight: 600;
    }

    .form-group input {
        width: 100%;
        padding: 0.75rem;
        border: 2px solid #ddd;
        border-radius: 6px;
        font-size: 1rem;
        transition: border-color 0.3s;
    }

    .form-group input:focus {
        outline: none;
        border-color: #044caa;
        box-shadow: 0 0 0 3px rgba(4, 76, 170, 0.1);
    }

    .signup-submit-btn {
        width: 100%;
        padding: 0.75rem;
        background: #044caa;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.3s;
    }

    .signup-submit-btn:hover {
        background: #0456c0;
    }

    .signup-links {
        text-align: center;
        margin-top: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid #eee;
    }

    .signup-links p {
        color: #666;
        font-size: 0.9rem;
        margin-bottom: 0.75rem;
    }

    .signup-links a {
        color: #044caa;
        text-decoration: none;
        font-weight: 600;
    }

    .signup-links a:hover {
        text-decoration: underline;
    }

    .error-messages {
        background: #fee2e2;
        color: #991b1b;
        padding: 1rem;
        border-radius: 6px;
        margin-bottom: 1.5rem;
    }

    .error-messages ul {
        margin: 0;
        padding-left: 1.5rem;
    }

    .error-messages li {
        margin: 0.5rem 0;
    }
</style>

<div class="signup-wrapper">
    <div class="signup-container">
        <h1 class="signup-header">Create Account</h1>
        <p class="signup-subtitle">Join Pseudocoder today</p>

        <% if @user.errors.any? %>
        <div class="error-messages">
            <h3><%= pluralize(@user.errors.count, "error") %> prohibited this user from being saved:</h3>
            <ul>
                <% @user.errors.full_messages.each do |message| %>
                <li><%= message %></li>
                <% end %>
            </ul>
        </div>
        <% end %>

        <%= form_with model: @user, local: true do |f| %>
        <div class="form-group">
            <label for="name">Name</label>
            <%= f.text_field :name, required: true, placeholder: "Your name" %>
        </div>

        <div class="form-group">
            <label for="email">Email Address</label>
            <%= f.email_field :email, required: true, placeholder: "your@email.com" %>
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <%= f.password_field :password, required: true, placeholder: "••••••••" %>
        </div>

        <div class="form-group">
            <label for="password_confirmation">Confirm Password</label>
            <%= f.password_field :password_confirmation, required: true, placeholder: "••••••••" %>
        </div>

        <%= f.submit "Create Account", class: "signup-submit-btn" %>
        <% end %>

        <div class="signup-links">
            <p>Already have an account?</p>
            <a href="<%= login_path %>">Sign In</a>
        </div>
    </div>
</div>
</body>

</html>