<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .loginpage {
            width: 400px;
            background: white;
            margin: auto;
            padding: 30px;
            border-radius: 20px;
            box-shadow: 10px 10px lightgray;
        }

        .container {
            background: #334464;
            height: 100vh;
            display: flex;
        }

        .header {
            font-family: "Atkinson Hyperlegible Next", serif;
            font-size: 36px;
        }

        .email1,
        .Password1,
        .username1 {
            border: none;
            border-bottom: 1px solid black;
            width: 335px;
            outline: none;
            margin-bottom: 10px;
        }

        .login1 {
            border: none;
            border-radius: 10px;
            width: 90px;
            height: 45px;
            background: mediumblue;
            color: white;
            cursor: pointer;
        }

        .login1:hover {
            background: blue;
        }

        header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 20px 40px;
            background: #222;
            color: white;
        }

        .logo {
            font-size: 24px;
            font-weight: bold;
        }

        .logo a {
            color: chocolate;
            text-decoration: none;
        }

        .nav {
            list-style: none;
            display: flex;
        }

        .nav li {
            margin-left: 20px;
        }

        .nav a {
            text-decoration: none;
            color: white;
            font-size: 18px;
        }

        .nav a:hover {
            color: green;
        }

        .account {
            margin-top: 10px;
        }
    </style>
</head>

<body>


    <div class="container">
        <div class="loginpage">
            <h2 class="header">Sign In</h2><br><br>

            <% if flash[:alert] %>
            <p style="color: red; margin-bottom: 10px;"><%= flash[:alert] %></p>
            <% end %>

            <%= form_with url: login_path, local: true do %>
            <div class="email">
                <%= label_tag :email %><br>
                <%= email_field_tag :email, params[:email], class: "email1" %>
            </div>

            <div class="password">
                <%= label_tag :password %><br>
                <%= password_field_tag :password, nil, class: "Password1" %>
            </div>

            <div class="login">
                <%= submit_tag "Log in", class: "login1" %>
            </div>
            <% end %>

            <div class="account">
                <p>No account? <%= link_to "Sign up", new_user_path %></p>
            </div>
        </div>
    </div>

</body>

</html>