module Compiler

  class Generator

    attr_reader ast: ProgramNode

    attr_reader ast_text: String

    attr_reader english: String

    def initialize: (ProgramNode) -> void

    def generate: (ProgramNode) -> String

    private

    def emit_block: { () -> String } -> String

    def generate_fn: (FunctionNode) -> String

    def generate_expr: (ExpressionNode) -> String

    def generate_stmt: (StatementNode) -> String

    def generate_conditional: (ConditionalNode) -> String

    def generate_if: (IfNode) -> String

    def generate_while: (WhileNode) -> String

    def generate_for: (ForNode) -> String
end

end