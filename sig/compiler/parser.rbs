module Compiler
  class Parser

    JAVA_TYPES: Array[Symbol]

    @tokens: [Tokenizer::Token]
    @lang: String

    attr_accessor ast: [ASTNode]

    def initialize: ([Tokenizer::Token], String) -> void

    def parse: -> ProgramNode

    private

    def parse_class: (?Array[Symbol]) -> ClassNode

    def keywords_conflict?: (ASTNode) -> bool

    def parse_conditional: -> StatementNode

    def parse_java_arg: -> ArgNode

    def parse_modifiers: -> Array[Symbol]

    def parse_while: -> WhileNode

    def parse_for: -> ForNode

    def parse_break: -> BreakNode

    def parse_continue: -> ContinueNode

    def parse_binary_expr: (?float) -> ExpressionNode

    def parse_unary_expr: -> UnaryExprNode

    def parse_if: -> IfNode

    def parse_else: -> (IfNode | Array[ExpressionNode])

    def binding_power: (String) -> [Integer]

    def parse_expr: -> ExpressionNode

    def parse_assignment: -> AssignmentNode

    def parse_return: -> RetNode

    def parse_arr: -> ArrDeclNode

    def parse_var_set: -> (DeclarationNode | AssignmentNode)

    def parse_python: -> Array[ASTNode]

    def parse_java: -> Array[ASTNode]

    def parse_js: -> Array[ASTNode]

    def parse_def: (?Array[Symbol]?) -> FunctionNode

    def parse_str: -> StringNode

    def parse_bool: -> BoolNode

    def parse_number: -> NumberNode
    
    def parse_call: -> CallNode

    def parse_args: -> Array[ArgNode]
    
    def parse_arg_exprs: -> [ExpressionNode]
    
    def parse_var_ref: -> VarRefNode

    def peek?: (Symbol, ?Integer) -> bool

    def peek_type: (?Integer) -> Symbol

    def peek_token: (?Integer) -> Tokenizer::Token

    def consume!: (Symbol) -> Tokenizer::Token

    def loc_range: (Tokenizer::Location | LocationRange, Tokenizer::Location | LocationRange) -> LocationRange
  end

end